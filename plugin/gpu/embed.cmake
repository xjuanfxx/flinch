# Concatenates text files into a C++ header holding one null-terminated byte array.
# A byte array (not a string literal) avoids MSVC's string literal size limit.
# Usage: cmake -DOUTPUT=x.h -DNAME=kSymbol -DFILES="a|b|c" -P embed.cmake
string(REPLACE "|" ";" files "${FILES}")
set(hex "")
foreach(f IN LISTS files)
  file(READ "${f}" content HEX)
  string(APPEND hex "${content}0a")
endforeach()
string(APPEND hex "00")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)"
       "\\1\n" bytes "${bytes}")
file(WRITE "${OUTPUT}" "// Generated by plugin/gpu/embed.cmake. Do not edit.\n#pragma once\n"
                       "static const unsigned char ${NAME}_bytes[] = {\n${bytes}\n};\n"
                       "static const char* const ${NAME} = reinterpret_cast<const char*>(${NAME}_bytes);\n")
